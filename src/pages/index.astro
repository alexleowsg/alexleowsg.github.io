---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
 
// ─────────────────────────────────────────────────────────────
// Landing page content. Edit the text here.
// ─────────────────────────────────────────────────────────────
const focusAreas = [
	{
		title: 'ServiceNow / CMDB',
		text: 'CSA and CIS-DF learning, CMDB concepts, CSDM, ITSM workflows, and hands-on practice in a developer instance.',
	},
	{
		title: 'ITSM Practice',
		text: 'Incident, request, change and problem workflows, with a focus on documentation, escalation clarity, operational follow-up, and service support discipline..',
	},
	{
		title: 'Homelab',
		text: 'Self-hosted tools, Docker containers, reverse proxy setup, storage choices, and practical maintenance notes.',
	},
	{
		title: 'Cloud / Automation',
		text: 'AWS fundamentals, GitHub Actions, scripting ideas, and small automation experiments.',
	},
];
 
// Latest 3 posts, newest first — updates automatically when you publish.
const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---
 
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Hi, I'm Alex.</h1>
				<p class="headline">IT operations engineer, working toward ServiceNow CMDB &amp; ITSM.</p>
				<p>
					I work in IT operations, where small details like configuration data, asset records, deployment status, and handover notes can decide whether support work flows smoothly or becomes messy.
					This site is where I document what I'm learning, from ServiceNow, CSDM and ITSM practice to homelab builds and cloud experiments, including the parts that broke.									
				</p>
				<p class="cta">
					<a class="button" href="/blog/">Read the blog</a>
					<a class="button secondary" href="/resume/">View resume</a>
				</p>
			</section>
 
			<section>
				<h2>What I work on</h2>
				<ul class="focus">
					{focusAreas.map((f) => (
						<li>
							<h3>{f.title}</h3>
							<p>{f.text}</p>
						</li>
					))}
				</ul>
			</section>
 
			<section>
				<h2>Latest posts</h2>
				<ul class="posts">
					{latestPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="date"><FormattedDate date={post.data.pubDate} /></span>
							{post.data.description && <p>{post.data.description}</p>}
						</li>
					))}
				</ul>
				<p><a href="/blog/">All posts →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
 
<style>
	main {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}
	section {
		margin-bottom: 3em;
	}
	.hero h1 {
		margin-bottom: 0.2em;
	}
	.headline {
		font-size: 1.3em;
		color: rgb(var(--gray-dark));
		margin-top: 0;
	}
	.cta {
		display: flex;
		gap: 1em;
		flex-wrap: wrap;
		margin-top: 1.5em;
	}
	.button {
		display: inline-block;
		padding: 0.5em 1.2em;
		border-radius: 6px;
		background: var(--accent);
		color: white;
		text-decoration: none;
		font-weight: 600;
	}
	.button.secondary {
		background: transparent;
		color: var(--accent);
		border: 2px solid var(--accent);
	}
	.focus {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1em;
	}
	.focus li {
		padding: 1em 1.2em;
		background: white;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
	}
	.focus h3 {
		font-size: 1.1em;
		margin: 0 0 0.4em;
	}
	.focus p {
		margin: 0;
		font-size: 0.9em;
		line-height: 1.5;
	}
	.posts {
		list-style: none;
		padding: 0;
	}
	.posts li {
		margin-bottom: 1.2em;
	}
	.posts a {
		font-weight: 700;
		font-size: 1.1em;
	}
	.posts .date {
		display: block;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.posts p {
		margin: 0.2em 0 0;
	}
	@media (max-width: 720px) {
		.focus {
			grid-template-columns: 1fr;
		}
	}
</style>